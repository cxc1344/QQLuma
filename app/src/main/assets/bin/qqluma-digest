#!/bin/sh
# qqluma-digest — per-group digest （概括） mode switch for the in-sandbox agent.
#
# State lives OUTSIDE the rootfs at /qqluma-data/digest/groups.json and is shared with
# the Android app (DigestStore.kt) — same JSON shape, atomic tmp+rename writes:
#   { "groups": { "<groupId>": { "name": "...", "enabled": true, "updatedAt": 123 } } }
#
# Usage:
#   qqluma-digest set <group_id> <on|off> [group_name]
#   qqluma-digest get <group_id>        -> prints on|off
#   qqluma-digest list                  -> group_id <TAB> on|off <TAB> name
#
# QQLUMA_DATA overrides the data dir (testing); default /qqluma-data.
DATA="${QQLUMA_DATA:-/qqluma-data}"
exec python3 - "$DATA" "$@" <<'PYEOF'
import json, os, sys, time

data_dir, args = sys.argv[1], sys.argv[2:]
path = os.path.join(data_dir, "digest", "groups.json")

def load():
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return {"groups": {}}

def save(doc):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(doc, f, ensure_ascii=False, indent=2)
    os.replace(tmp, path)

cmd = args[0] if args else "list"
doc = load()
groups = doc.setdefault("groups", {})

if cmd == "set" and len(args) >= 3:
    gid = args[1]
    enabled = args[2].lower() in ("on", "true", "1")
    name = args[3] if len(args) > 3 else groups.get(gid, {}).get("name", "")
    groups[gid] = {"name": name, "enabled": enabled, "updatedAt": int(time.time() * 1000)}
    save(doc)
    print("OK %s %s" % (gid, "on" if enabled else "off"))
elif cmd == "get" and len(args) >= 2:
    g = groups.get(args[1])
    print("on" if g and g.get("enabled") else "off")
elif cmd == "list":
    for gid in sorted(groups):
        g = groups[gid]
        print("%s\t%s\t%s" % (gid, "on" if g.get("enabled") else "off", g.get("name", "")))
else:
    print("usage: qqluma-digest set <group_id> <on|off> [name] | get <group_id> | list",
          file=sys.stderr)
    sys.exit(2)
PYEOF
